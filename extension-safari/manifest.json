{
  "manifest_version": 3,
  "name": "Job Portal Autofill",
  "version": "0.1.0",
  "description": "Fill job-application forms from your Job Application Portal profile.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:4000/*"],
  "action": {
    "default_title": "Autofill this application",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
