# Copy this file to ".env" and fill in the values you have.
# The app runs without any keys (Remotive works key-free and cover letters
# fall back to a template), but each key you add unlocks more functionality.

# Server
PORT=4000
# Bind for LAN access (Safari on iPad extension). See extension-safari/README.md
HOST=0.0.0.0

# Phase 2.7 — comma-separated browser extension origins allowed to call /api/extension/*
# Chrome and Safari use different IDs; add each after installing the extension.
EXTENSION_ALLOWED_ORIGINS=

# --- Job board providers ---------------------------------------------------

# Adzuna (free): https://developer.adzuna.com/  -> create an app to get these.
# Aggregates listings from Indeed, LinkedIn-adjacent boards and thousands more.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Default country code for Adzuna searches (us, gb, ca, au, de, fr, ...).
ADZUNA_COUNTRY=us

# Jooble (free): https://jooble.org/api/about -> request an API key.
JOOBLE_API_KEY=

# USAJOBS (free, US federal jobs): https://developer.usajobs.gov/
# Needs both the API key and the email you registered with.
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# The Muse (free): works with no key. An optional key raises rate limits.
# https://www.themuse.com/developers/api/v2
THE_MUSE_API_KEY=

# These boards need NO key and are always enabled:
#   Remotive, The Muse, RemoteOK, Arbeitnow, Jobicy

# --- AI cover letters / application answers --------------------------------

# Optional. If set, tailored cover letters and application-question answers
# are generated with Claude. Without it, a solid template is used instead.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
