# Copy this file to ".env" and fill in the values you have.
# The app runs without any keys (Remotive works key-free and cover letters
# fall back to a template), but each key you add unlocks more functionality.

# Server
PORT=4000
# Bind for LAN access (Safari on iPad extension). See extension-safari/README.md
HOST=0.0.0.0

# Phase 2.7 — comma-separated browser extension origins allowed to call /api/extension/*
# Chrome and Safari use different IDs; add each after installing the extension.
EXTENSION_ALLOWED_ORIGINS=

# Phase 2.8 — shared secret required on /api/extension/* when set. Recommended
# before exposing the portal on a LAN (e.g. HOST=0.0.0.0 for the iPad extension).
# Paste the same value into the extension Options. Empty = no token required.
PORTAL_TOKEN=

# --- Job board providers ---------------------------------------------------

# Adzuna (free): https://developer.adzuna.com/  -> create an app to get these.
# Aggregates listings from Indeed, LinkedIn-adjacent boards and thousands more.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Default country code for Adzuna searches (us, gb, ca, au, de, fr, ...).
ADZUNA_COUNTRY=us

# Jooble (free): https://jooble.org/api/about -> request an API key.
JOOBLE_API_KEY=

# USAJOBS (free, US federal jobs): https://developer.usajobs.gov/
# Needs both the API key and the email you registered with.
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# The Muse (free): works with no key. An optional key raises rate limits.
# https://www.themuse.com/developers/api/v2
THE_MUSE_API_KEY=

# These boards need NO key and are always enabled:
#   Remotive, The Muse, RemoteOK, Arbeitnow, Jobicy

# --- AI cover letters / application answers --------------------------------
#
# Optional. Without any key below, cover letters, apply plans, positioning,
# and job-fit scoring all use the free deterministic templates/heuristics in
# heuristics.js and orchestrator.js — real output, tailored from your actual
# profile/resume data, just not written word-for-word by a model.
#
# Provider priority when a key IS set: Gemini first, then Anthropic. Setting
# only GEMINI_API_KEY means Anthropic is never called.

# Gemini (free tier) — recommended, no cost. Get a key at:
#   https://aistudio.google.com/apikey
# A Gemini Developer API key looks like "AIzaSy..." (39 chars). Free-tier
# keys just return HTTP 429 (rate limited) once you exceed the free daily/
# per-minute quota — they do NOT start silently billing you. That only
# changes if you separately enable Cloud Billing on the backing Google Cloud
# project, so double-check https://console.cloud.google.com/billing shows no
# billing account linked to that project if you want a hard guarantee.
# As a second line of defense, the app also enforces its own daily call cap
# (GEMINI_DAILY_CALL_CAP below) and falls back to the free template instead
# of ever erroring out.
GEMINI_API_KEY=
# Override the model priority list (gemini-2.5-pro -> gemini-2.5-flash ->
# gemini-2.0-flash). Leave unset to use that priority order automatically.
# GEMINI_MODEL=
# Hard self-imposed ceiling on Gemini calls per day, independent of whatever
# Google's own free-tier quota is. Once hit, every AI task falls back to the
# free template for the rest of the day instead of calling out again.
# GEMINI_DAILY_CALL_CAP=200

# Anthropic (paid) — optional, off by default. Only set this if you want to
# spend your own money on higher-quality generation; otherwise leave blank.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Stagehand / Chrome CDP (Phase 2.4 auto-submit) ------------------------

# Chrome must be launched with remote debugging, e.g.:
#   google-chrome --remote-debugging-port=9222
# Stagehand attaches here instead of launching its own browser.
CHROME_CDP_URL=http://localhost:9222
# CHROME_CDP_CONNECT_TIMEOUT_MS=30000
# STAGEHAND_VERBOSE=0
